# Copy this file to .env.local and fill in values from the Firebase console.
# In the Firebase console: Project Settings -> General -> Your apps -> Web app config.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=ghc-advance-learning-modules.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=ghc-advance-learning-modules
VITE_FIREBASE_STORAGE_BUCKET=ghc-advance-learning-modules.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Set to "true" to talk to local Firebase Emulator Suite during dev.
VITE_USE_EMULATORS=false
