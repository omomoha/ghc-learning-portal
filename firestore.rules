rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { return request.auth != null; }
    function isSelf(uid)  { return isSignedIn() && request.auth.uid == uid; }

    /**
     * Admin check accepts EITHER source of truth:
     *   1. Firebase Auth custom claim `admin: true` (set via the Admin SDK / setAdminRole Function), OR
     *   2. The caller's /users/{uid} doc has role == "admin"
     *
     * The Firestore lookup adds one document read per rule evaluation but makes
     * admin promotion via the Firestore console (or Admin UI direct writes) work
     * without needing a custom-claim refresh.
     *
     * Note: users cannot grant themselves admin because the /users/{uid} update
     * rule below blocks self-role-elevation.
     */
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.admin == true ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
    }

    function notChangingOwnRole() {
      // True when the incoming role matches the existing role, or the role field is absent
      // from the resource entirely.
      return !('role' in request.resource.data) ||
        !('role' in resource.data) ||
        request.resource.data.role == resource.data.role;
    }

    // User profile docs.
    // Read: self or admin.
    // Create: self only (first-time profile on signup).
    // Update: an admin can update anything. Self can update non-role fields only.
    // Delete: admin only.
    match /users/{uid} {
      allow read:   if isSelf(uid) || isAdmin();
      allow create: if isSelf(uid);
      allow update: if isAdmin() || (isSelf(uid) && notChangingOwnRole());
      allow delete: if isAdmin();

      // Per-user progress: learner reads/writes own; admin reads only.
      match /progress/{moduleId} {
        allow read:  if isSelf(uid) || isAdmin();
        allow write: if isSelf(uid);
      }

      // Per-user assessment attempts: same rule.
      match /assessments/{moduleId} {
        allow read:  if isSelf(uid) || isAdmin();
        allow write: if isSelf(uid);
      }
    }

    // Learning resources (PDFs, slides, video links, external URLs).
    // Any signed-in user can read; only admins can write.
    match /resources/{resourceId} {
      allow read:  if isSignedIn();
      allow write: if isAdmin();
    }

    // Optional: server-managed modules collection (if/when admins edit modules in-app).
    match /modules/{moduleId} {
      allow read:  if isSignedIn();
      allow write: if isAdmin();
    }
  }
}
